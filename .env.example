ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 省略可。既定値は claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# --- ログイン・セッション関連 ---
# 32バイト以上のランダム文字列を設定すること。生成例:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-change-this-to-a-long-random-string
SESSION_STORE_DIR=./sessions
# セッション有効期限(ミリ秒)。既定値は7日
SESSION_MAX_AGE_MS=604800000
# リバースプロキシ配下で動かす場合は1（trust proxyを有効化し、secure cookie判定を正しく行う）
TRUST_PROXY=1
# 本番(インターネット公開)では production にする。secure cookieが有効になる
NODE_ENV=development
