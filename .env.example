ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 省略可。既定値は claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# --- Grok(xAI)。生成タブの「使用するAI」でGrokを選んだ場合のみ使用（性能比較用の実験的機能） ---
# 未設定の場合、Grokを選んでの生成のみ失敗する（Claudeでの生成には影響しない）
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 省略可。既定値は grok-4.20-0309-non-reasoning
# (grok-4.6は推論により60〜100秒程度かかることがあり、Vercelの関数タイムアウトを超えるおそれがあるため既定では使わない)
XAI_MODEL=grok-4.20-0309-non-reasoning

# --- データベース(Postgres。Vercel Postgres/Neon等) ---
# アカウント情報・履歴・禁止ワード・文章の癖・個人サンプルの保存先。
# Vercel用はプーラー経由の接続文字列、ローカルCLI(create-account.js)用はDirect接続でも可。
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- ログイン・セッション関連 ---
# 32バイト以上のランダム文字列を設定すること。生成例:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-change-this-to-a-long-random-string
# セッション有効期限(ミリ秒)。既定値は7日
SESSION_MAX_AGE_MS=604800000
# リバースプロキシ配下で動かす場合は1（trust proxyを有効化し、secure cookie判定を正しく行う）。Vercel上は1
TRUST_PROXY=1
# 本番(インターネット公開)では production にする。secure cookieが有効になる。Vercelは自動設定される
NODE_ENV=development
